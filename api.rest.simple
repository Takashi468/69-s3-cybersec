# REST — Strapi API (localhost:9093)

@host = http://localhost:9093

# ADMIN SESSION

### Login (Admin)
# @name adminLogin
POST {{host}}/admin/login
Content-Type: application/json

{
    "email": "",
    "password": "",
    "rememberMe": true
}

### Signup (Admin)
POST {{host}}/admin/register-admin
Content-Type: application/json

{
    "firstname": "",
    "lastname": "",
    "email": "",
    "password": ""
}

### Forgot Password (Admin)
POST {{host}}/admin/forgot-password
Content-Type: application/json

{
    "email": ""
}

###
# เปิด Mailpit ดู code จากอีเมลล่าสุด (Reset password) แล้วเอามาใส่ที่นี่:
#   http://127.0.0.1:8025   (ดู MAILPIT.md)
# หรือรันทั้ง flow ให้อัตโนมัติด้วย ./test-reset-password.sh admin
# fallback ถ้ายังไม่ได้ตั้ง Mailpit: ดึง reset_password_token จาก admin_users ใน DB เอง
# (ไม่ว่าวิธีไหน token เก่าใช้ไม่ได้แล้วถ้ากด Forgot Password ซ้ำ ต้องเอาตัวล่าสุดเสมอ)
@adminResetToken =

### Reset Password (Admin)
POST {{host}}/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "{{adminResetToken}}",
    "password": ""
}

### Profile (Admin)
GET {{host}}/admin/users/me
Authorization: Bearer {{adminLogin.response.body.$.data.token}}

# USER SESSION

### Login (User)
# @name userLogin
POST {{host}}/api/auth/local
Content-Type: application/json

{
    "identifier": "",
    "password": ""
}

### Signup (User)
POST {{host}}/api/auth/local/register
Content-Type: application/json

{
    "username": "",
    "email": "",
    "password": ""
}

### Forgot Password (User)
POST {{host}}/api/auth/forgot-password
Content-Type: application/json

{
    "email": ""
}

###
# เปิด Mailpit ดู code จากอีเมลล่าสุด (Reset password) แล้วเอามาใส่ที่นี่:
#   http://127.0.0.1:8025   (ดู MAILPIT.md)
# หรือรันทั้ง flow ให้อัตโนมัติด้วย ./test-reset-password.sh user
# fallback ถ้ายังไม่ได้ตั้ง Mailpit: ดึง reset_password_token จาก up_users ใน DB เอง
# (ไม่ว่าวิธีไหน token เก่าใช้ไม่ได้แล้วถ้ากด Forgot Password ซ้ำ ต้องเอาตัวล่าสุดเสมอ)
@userResetToken =

### Reset Password (User)
POST {{host}}/api/auth/reset-password
Content-Type: application/json

{
    "code": "{{userResetToken}}",
    "password": "",
    "passwordConfirmation": ""
}

### Profile (User)
GET {{host}}/api/users/me
Authorization: Bearer {{userLogin.response.body.$.jwt}}


### 3. Content Section

#### 3.1 Student
# ข้อควรระวังจาก prototype (schema แก้ไม่ได้):
# - mobile ต้องยาว 10 ตัว / cardId 13 ตัว พอดี และ unique — รัน Create ซ้ำด้วยค่าเดิมจะ fail
# - mobile ถูก md5-hash ตอน create เท่านั้น (lifecycles.js ใน image) → GET หลัง Create จะเห็น hash
#   แต่ Update ไม่ re-hash → ถ้า Update ด้วย mobile ใหม่ ค่าใน DB จะเป็น plaintext

##### 3.1.1 Create
# @name createStudent
POST {{host}}/api/students
Content-Type: application/json
Authorization: Bearer {{userLogin.response.body.$.jwt}}

{
    "data": {
        "name": "",
        "mobile": "",
        "cardId": "",
        "status": "published"
    }
}

##### 3.1.2 List All
GET {{host}}/api/students
Authorization: Bearer {{userLogin.response.body.$.jwt}}

##### 3.1.3 Get by ID
GET {{host}}/api/students/{{createStudent.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.$.jwt}}

##### 3.1.4 Update
PUT {{host}}/api/students/{{createStudent.response.body.$.data.id}}
Content-Type: application/json
Authorization: Bearer {{userLogin.response.body.$.jwt}}

{
    "data": {
        "name": "",
        "mobile": "",
        "cardId": "",
        "status": "published"
    }
}

#### 3.2 Subject
# name เป็น unique — รัน Create ซ้ำด้วยชื่อเดิมจะ fail

##### 3.2.1 Create
# @name createSubject
POST {{host}}/api/subjects
Content-Type: application/json
Authorization: Bearer {{userLogin.response.body.$.jwt}}

{
    "data": {
        "name": "",
        "status": "published"
    }
}

##### 3.2.2 List All
GET {{host}}/api/subjects
Authorization: Bearer {{userLogin.response.body.$.jwt}}

##### 3.2.3 Get by ID
GET {{host}}/api/subjects/{{createSubject.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.$.jwt}}

##### 3.2.4 Update
PUT {{host}}/api/subjects/{{createSubject.response.body.$.data.id}}
Content-Type: application/json
Authorization: Bearer {{userLogin.response.body.$.jwt}}

{
    "data": {
        "name": "",
        "status": "published"
    }
}

