# REST — Strapi API (localhost:9093)

@host = http://localhost:9093
# Admin JWT — จาก Login (Admin)
@token =
# User JWT — จาก Login (User)
@userToken =

# ADMIN SESSION

### Login (Admin)
POST {{host}}/admin/login
Content-Type: application/json

{
    "email": "",
    "password": "",
    "rememberMe": true
}

### Signup (Admin)
POST {{host}}/admin/register-admin
Content-Type: application/json

{
    "firstname": "",
    "lastname": "",
    "email": "",
    "password": ""
}

### Forgot Password (Admin)
POST {{host}}/admin/forgot-password
Content-Type: application/json

{
    "email": ""
}

### Profile (Admin)
GET {{host}}/admin/users/me
Authorization: Bearer {{token}}

# USER SESSION

### Login (User)
POST {{host}}/api/auth/local
Content-Type: application/json

{
    "identifier": "",
    "password": ""
}

### Signup (User)
POST {{host}}/api/auth/local/register
Content-Type: application/json

{
    "username": "",
    "email": "",
    "password": ""
}

### Forgot Password (User)
POST {{host}}/api/auth/forgot-password
Content-Type: application/json

{
    "email": ""
}

### Profile (User)
GET {{host}}/api/users/me
Authorization: Bearer {{userToken}}
