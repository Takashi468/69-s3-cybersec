# ── Postgres (superuser สำหรับ init เท่านั้น) ──────────────────
DATABASE_CLIENT=postgres
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DB=
DATABASE_USER=
DATABASE_PASSWORD=

# ── Strapi DB user (คนละ user/password กับ superuser) ──────────
STRAPI_DB_USER=strapi
STRAPI_DB_PASSWORD=

# ── pgAdmin (ต้องคนละรหัสกับ DB) ─────────────────────────────
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# ── Strapi admin (ต้องคนละรหัสกับ DB และ pgAdmin) ────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Strapi secrets ──────────────────────────────────────────
# gen ด้วย: openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# ── Host ports ──────────────────────────────────────────────
DB_PORT=
ADMIN_PORT=
APP_PORT=
